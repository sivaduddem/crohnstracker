FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY packages/shared/python /app/packages/shared/python
COPY apps/api/requirements.txt /app/apps/api/requirements.txt
RUN pip install --no-cache-dir -e /app/packages/shared/python \
    && pip install --no-cache-dir fastapi "uvicorn[standard]" python-multipart \
       pydantic pydantic-settings sqlalchemy numpy pillow httpx

COPY apps /app/apps
COPY ml /app/ml
COPY data/demo /app/data/demo
COPY artifacts /app/artifacts

ENV PYTHONPATH=/app
ENV APP_MODE=demo
ENV DEMO_DATA_DIR=/app/data/demo

RUN python ml/data/generate_demo_fixtures.py

EXPOSE 8000
CMD ["uvicorn", "apps.api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
